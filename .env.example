[TEMPLATE]
# ─── Discord Bot Configuration ───────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_application_id_here

# Guild ID opsional untuk deploy commands ke server tertentu (lebih cepat saat development).
# Kosongkan untuk deploy global ke semua server. Command di-deploy otomatis saat startup.
GUILD_ID=your_guild_id_here

# ─── Text-to-Speech (TTS) ─────────────────────────────────────────
# Bahasa default Edge TTS (id-ID, en-US, en-GB, ja-JP, ko-KR, zh-CN, ms-MY, es-ES, fr-FR, de-DE)
TTS_LANGUAGE=id-ID
# TTS_VOICE override bahasa-map voice jika diisi eksplisit (contoh: en-US-AriaNeural, id-ID-GadisNeural)
TTS_VOICE=id-ID-GadisNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# TTS_TRANSLATE_ENGLISH (default ON): jawaban voice di chat/aksi diterjemahkan
# ke Bahasa Inggris dan diucapkan dengan suara Inggris (en-US-AriaNeural).
# Set false untuk pakai bahasa/suara yang dikonfigurasi (TTS_LANGUAGE/TTS_VOICE).
TTS_TRANSLATE_ENGLISH=true

# ─── Custom OpenAI-compatible TTS (primary) ──────────────────────
# Aktif dengan mengisi CUSTOM_TTS_BASE_URL + CUSTOM_TTS_MODEL.
# Jika gagal, otomatis fallback ke Edge TTS.
CUSTOM_TTS_BASE_URL=
CUSTOM_TTS_API_KEY=
CUSTOM_TTS_MODEL=
CUSTOM_TTS_VOICE=alloy
CUSTOM_TTS_LANGUAGE=en-US
CUSTOM_TTS_RESPONSE_FORMAT=mp3
CUSTOM_TTS_SPEED=1
CUSTOM_TTS_TIMEOUT_MS=30000

# ─── Zona Waktu untuk Reminder (format IANA Timezone) ─────────────
TIMEZONE=Asia/Jakarta

# ─── Persistence (file dibuat otomatis; arahkan ke persistent volume saat deploy) ─
# SQLite Reminder DB
DATABASE_PATH=./data/voice-reminders.db
# SQLite User Memory DB (per-user quiet mode, custom instructions, learned facts)
USER_MEMORY_DB_PATH=./data/user-memory.db
# Opsional: file reminder JSON lama yang akan dimigrasikan sekali
LEGACY_REMINDERS_FILE=./data/voice-reminders.json
# Per-guild settings (VoiceMaster, welcome channel, voice welcome toggle, dll)
SERVER_SETTINGS_FILE=./data/server-settings.json
# Warning data file
WARNINGS_FILE=./data/warnings.json
# Timezone untuk supervisor midnight-restart (default: TIMEZONE atau Asia/Bangkok)
RESTART_TZ=Asia/Bangkok

# ─── AI Providers ─────────────────────────────────────────────────
# OpenRouter API Key (gratis: https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Model OpenRouter (free tier: 'openrouter/free' atau model lain seperti 'openai/gpt-oss-20b:free')
OPENROUTER_MODEL=openrouter/free

# Gemini API Key (https://aistudio.google.com/app/apikey)
# Bisa isi banyak key dipisahkan koma untuk bypass rate limit harian!
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# Groq API Key & Model (100% Free & Super Cepat: https://console.groq.com/keys)
# Bisa isi banyak key dipisahkan koma
GROQ_API_KEYS=gsk_key_1,gsk_key_2
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# SambaNova (100% Free & High Speed Llama 3.3 70B: https://cloud.sambanova.ai/)
SAMBANOVA_API_KEY=
# SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# Mistral AI (Gratis di https://console.mistral.ai/)
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# GitHub Models (100% Free pakai GitHub Personal Access Token / PAT: https://github.com/marketplace/models)
GITHUB_TOKEN=
# GITHUB_MODEL=gpt-4o-mini

# Together AI (Free credits: https://api.together.xyz/)
TOGETHER_API_KEY=
# TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# DeepInfra (Free credits: https://deepinfra.com/)
DEEPINFRA_API_KEY=
# DEEPINFRA_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# Cerebras API Key & Model (https://cloud.cerebras.ai/)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=Qwen/Qwen3-32B

# Puter API Key & Model (https://puter.com/)
PUTER_API_KEY=
PUTER_MODEL=claude-3-5-sonnet

# Pollinations API Key (https://pollinations.ai — opsional, tier gratis tanpa key)
POLLINATIONS_API_KEY=

# GitHub Models alternatif: key kedua selain GITHUB_TOKEN (opsional)
GITHUB_MODELS_KEY=

# ─── Custom / Named OpenAI-compatible AI ─────────────────────────────
# Kamu bisa pakai nama provider apa saja di AI_PROVIDER_ORDER (misal: 9router, agentrouter, hcnsec, custom).
# Cara 1: Pakai nama custom spesifik (contoh: 9ROUTER_BASE_URL, 9ROUTER_API_KEY, 9ROUTER_MODEL)
# Cara 2: Pakai generic CUSTOM_AI_BASE_URL (otomatis dipakai untuk semua nama custom)
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=your_custom_api_key_here
CUSTOM_AI_MODEL=your_custom_model_name_here
CUSTOM_AI_AUTH_PREFIX=Bearer
CUSTOM_AI_EXTRA_HEADERS=

# ─── Routing AI ───────────────────────────────────────────────────
# List provider dipisahkan koma; urutan di-load-balance (round-robin) bergantian.
# Kamu bisa isi provider bawaan & preset (groq, sambanova, mistral, github, gemini, openrouter, custom, 9router, hcnsec).
AI_PROVIDER_ORDER=groq,sambanova,mistral,github,gemini,openrouter,9router,hcnsec

# Opsional: fallback model diproses OpenRouter dalam satu HTTP request
# Pisahkan model ID dengan koma. Kosong = gunakan routing bawaan model primary.
OPENROUTER_FALLBACK_MODELS=

# Timeout per provider sebelum pindah otomatis ke provider berikutnya
AI_REQUEST_TIMEOUT_MS=20000

# ─── Owner ────────────────────────────────────────────────────────
# Owner ID — Discord user ID kamu (klik kanan nama → Copy User ID)
# Owner bisa pakai /admin dan !admin untuk kontrol penuh bot
OWNER_ID=your_discord_user_id_here

# ─── Search ───────────────────────────────────────────────────────
# Tavily Search API Key (OPSIONAL tapi DISARANKAN — gratis 1000 credits/bulan)
# Daftar di: https://tavily.com/
# Tanpa ini, bot hanya pakai Wikipedia + DuckDuckGo untuk pencarian
TAVILY_API_KEY=

# ─── Bot Customization ────────────────────────────────────────────
BOT_NAME=your_bot_name
WELCOME_CHANNEL_ID=your_welcome_channel_id_here
ANNOUNCE_CHANNEL_ID=your_announce_channel_id_here
# Mod log channel — alert moderasi manual dikirim ke sini (misal auto-kick gagal karena role terlalu tinggi)
MOD_LOG_CHANNEL_ID=your_mod_log_channel_id_here
# Gambar default untuk welcome embed kalau user tidak punya avatar banner
WELCOME_FALLBACK_IMAGE=

# ─── Logging ──────────────────────────────────────────────────────
# debug | info | warn | error (default: info)
LOG_LEVEL=info

# ─── TTS Translation Model ────────────────────────────────────────
# Model OpenRouter untuk terjemah jawaban voice ke English (default: openai/gpt-oss-20b:free)
TTS_TRANSLATE_MODEL=openai/gpt-oss-20b:free

# ─── AI Routing Circuit Breaker & Cooldowns ───────────────────────
AI_CIRCUIT_FAILURE_THRESHOLD=2
AI_CIRCUIT_COOLDOWN_MS=30000
AI_RATELIMIT_COOLDOWN_MS=60000
AI_QUOTA_COOLDOWN_MS=300000

# ─── AI Max Tokens ────────────────────────────────────────────────
MAX_TOKENS_DEFAULT=512
MAX_TOKENS_ROUTING=220
MAX_TOKENS_SIMPLE_CHAT=512
MAX_TOKENS_COMPLEX_CHAT=1000

# ─── Secret Persona ───────────────────────────────────────────────
SECRET_BEHAVIOR=Tsundere Persona: Smart, sarcastic, caring, highly loyal to creator. Aggressive/arrogant facade, uses expressive emojis, acts superior, seeks validation, hates showing weakness.
