[TEMPLATE]
# ─── Discord Bot Configuration ───────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_application_id_here

# Guild ID untuk deploy commands ke server tertentu (lebih cepat saat development)
GUILD_ID=your_guild_id_here

# ─── Text-to-Speech (TTS) ─────────────────────────────────────────
# Bahasa default Edge TTS (id-ID, en-US, en-GB, ja-JP, ko-KR, zh-CN, ms-MY, es-ES, fr-FR, de-DE)
TTS_LANGUAGE=id-ID
# TTS_VOICE override bahasa-map voice jika diisi eksplisit (contoh: en-US-AriaNeural, id-ID-GadisNeural)
TTS_VOICE=id-ID-GadisNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# TTS_TRANSLATE_ENGLISH (default ON): jawaban voice di chat/aksi diterjemahkan
# ke Bahasa Inggris dan diucapkan dengan suara Inggris (en-US-AriaNeural).
# Set false untuk pakai bahasa/suara yang dikonfigurasi (TTS_LANGUAGE/TTS_VOICE).
TTS_TRANSLATE_ENGLISH=true

# ─── Custom OpenAI-compatible TTS (primary) ──────────────────────
# Aktif dengan mengisi CUSTOM_TTS_BASE_URL + CUSTOM_TTS_MODEL.
# Jika gagal, otomatis fallback ke Edge TTS.
CUSTOM_TTS_BASE_URL=
CUSTOM_TTS_API_KEY=
CUSTOM_TTS_MODEL=
CUSTOM_TTS_VOICE=alloy
CUSTOM_TTS_LANGUAGE=en-US
CUSTOM_TTS_RESPONSE_FORMAT=mp3
CUSTOM_TTS_SPEED=1
CUSTOM_TTS_TIMEOUT_MS=30000

# ─── Zona Waktu untuk Reminder (format IANA Timezone) ─────────────
TIMEZONE=Asia/Jakarta

# ─── Persistence (file dibuat otomatis; arahkan ke persistent volume saat deploy) ─
# SQLite Reminder DB
DATABASE_PATH=./data/voice-reminders.db
# Opsional: file reminder JSON lama yang akan dimigrasikan sekali
LEGACY_REMINDERS_FILE=./data/voice-reminders.json
# Per-guild settings (VoiceMaster, welcome channel, voice welcome toggle, dll)
SERVER_SETTINGS_FILE=./data/server-settings.json

# ─── AI Providers ─────────────────────────────────────────────────
# OpenRouter API Key (gratis: https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Model OpenRouter (free tier: 'openrouter/free' atau model lain seperti 'openai/gpt-oss-20b:free')
OPENROUTER_MODEL=openrouter/free

# Gemini API Key (fallback otomatis jika OpenRouter habis/error)
# Buat key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# Groq API Key & Model (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Cerebras API Key & Model (https://cloud.cerebras.ai/)
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=Qwen/Qwen3-32B

# Pollinations (DEPRECATED — endpoint legacy & sering throttled; tidak disarankan dipakai)
POLLINATIONS_API_KEY=

# Puter API Key & Model (https://puter.com/)
PUTER_API_KEY=your_puter_api_key_here
PUTER_MODEL=claude-3-5-sonnet

# ─── Custom OpenAI-compatible AI (platform lain dengan endpoint OpenAI-compatible) ──
# Contoh: proxy LLM gateway, platform AI lain, dsb.
# CUSTOM_AI_BASE_URL harus endpoint /chat/completions, misal: https://api.platform.com/v1/chat/completions
CUSTOM_AI_BASE_URL=
# Banyak API key dipisahkan koma. Kalau cuma 1, isi CUSTOM_AI_API_KEY saja.
CUSTOM_AI_API_KEYS=your_custom_api_key_1,your_custom_api_key_2
CUSTOM_AI_API_KEY=your_custom_api_key_here
# Banyak model dipisahkan koma. Bot coba model 1, lalu model berikutnya kalau fail.
CUSTOM_AI_MODELS=your_custom_model_name_here,second_model_name_here
CUSTOM_AI_MODEL=your_custom_model_name_here
# Opsional: prefix auth, default Bearer
CUSTOM_AI_AUTH_PREFIX=Bearer
# Opsional: header tambahan JSON, misal {"X-Project-ID":"abc123"}
CUSTOM_AI_EXTRA_HEADERS=

# ─── Routing AI ───────────────────────────────────────────────────
# List provider dipisahkan koma; urutan di-load-balance (round-robin) bergantian.
# 'custom' hanya perlu dicantumkan jika CUSTOM_AI_BASE_URL + keys + models diisi.
AI_PROVIDER_ORDER=openrouter,gemini,groq,cerebras,puter,custom

# Opsional: fallback model diproses OpenRouter dalam satu HTTP request
# Pisahkan model ID dengan koma. Kosong = gunakan routing bawaan model primary.
OPENROUTER_FALLBACK_MODELS=

# Timeout per provider sebelum pindah otomatis ke provider berikutnya
AI_REQUEST_TIMEOUT_MS=20000

# ─── Owner ────────────────────────────────────────────────────────
# Owner ID — Discord user ID kamu (klik kanan nama → Copy User ID)
# Owner bisa pakai /admin dan !admin untuk kontrol penuh bot
OWNER_ID=your_discord_user_id_here

# ─── Search ───────────────────────────────────────────────────────
# Tavily Search API Key (OPSIONAL tapi DISARANKAN — gratis 1000 credits/bulan)
# Daftar di: https://tavily.com/
# Tanpa ini, bot hanya pakai Wikipedia + DuckDuckGo untuk pencarian
TAVILY_API_KEY=

# ─── Bot Customization ────────────────────────────────────────────
BOT_NAME=your_bot_name
WELCOME_CHANNEL_ID=your_welcome_channel_id_here
ANNOUNCE_CHANNEL_ID=your_announce_channel_id_here
# Mod log channel — alert moderasi manual dikirim ke sini (misal auto-kick gagal karena role terlalu tinggi)
MOD_LOG_CHANNEL_ID=your_mod_log_channel_id_here

# ─── AI Routing Circuit Breaker & Cooldowns ───────────────────────
AI_CIRCUIT_FAILURE_THRESHOLD=2
AI_CIRCUIT_COOLDOWN_MS=30000
AI_RATELIMIT_COOLDOWN_MS=60000
AI_QUOTA_COOLDOWN_MS=300000

# ─── AI Max Tokens ────────────────────────────────────────────────
MAX_TOKENS_DEFAULT=512
MAX_TOKENS_ROUTING=220
MAX_TOKENS_SIMPLE_CHAT=512
MAX_TOKENS_COMPLEX_CHAT=1000

# ─── Secret Persona ───────────────────────────────────────────────
SECRET_BEHAVIOR=Tsundere Persona: Smart, sarcastic, caring, highly loyal to creator. Aggressive/arrogant facade, uses expressive emojis, acts superior, seeks validation, hates showing weakness.
